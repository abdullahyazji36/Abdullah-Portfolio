generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String    @id @default(cuid())
  email    String    @unique
  name     String?
  projects Project[]

  @@map("users")
}

model Project {
  id      String  @id @default(cuid())
  title   String
  content String?
  userId  String  @map("user_id")
  user    User    @relation(fields: [userId], references: [id])

  @@map("projects")
}

model SkillCategory {
  id     String  @id @default(cuid())
  name   String
  skills Skill[]

  @@map("skill_category")
}

model Skill {
  id         String        @id @default(cuid())
  name       String
  categoryId String        @map("category_id")
  category   SkillCategory @relation(fields: [categoryId], references: [id])
}
